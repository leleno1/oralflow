{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oralflow:schema:run:0.1.0",
  "title": "OralFlow Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "workflow_ref",
    "status",
    "node_runs",
    "attempt_count",
    "budget",
    "artifact_refs",
    "last_event_sequence",
    "created_at",
    "updated_at",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "parent_run_id": {
      "$ref": "#/$defs/identifier"
    },
    "workflow_ref": {
      "$ref": "#/$defs/pinnedWorkflowRef"
    },
    "status": {
      "enum": [
        "DRAFT",
        "VALIDATING",
        "READY",
        "RUNNING",
        "WAITING_FOR_USER",
        "PAUSED",
        "REPLANNING",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "node_runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeRun"
      }
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "budget": {
      "$ref": "#/$defs/budgetUsage"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^artifact://[A-Za-z0-9][A-Za-z0-9._/-]*$"
      },
      "uniqueItems": true
    },
    "last_event_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "pinnedWorkflowRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "workflow_version",
        "revision",
        "digest"
      ],
      "properties": {
        "workflow_id": {
          "$ref": "#/$defs/identifier"
        },
        "workflow_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "nodeRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "status",
        "attempt_count",
        "artifact_refs"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/identifier"
        },
        "role_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "IDLE",
            "QUEUED",
            "RUNNING",
            "WAITING_APPROVAL",
            "SUCCEEDED",
            "REJECTED",
            "RETRYABLE_FAILED",
            "TERMINAL_FAILED",
            "SKIPPED",
            "CANCELLED"
          ]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^artifact://[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "uniqueItems": true
        },
        "last_error": {
          "$ref": "#/$defs/error"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "category",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "category": {
          "enum": [
            "validation",
            "permission",
            "timeout",
            "tool",
            "provider",
            "budget",
            "cancelled",
            "internal"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        },
        "cause_event_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "budgetUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_duration_seconds",
        "elapsed_seconds",
        "max_transitions",
        "used_transitions",
        "max_tool_calls",
        "used_tool_calls"
      ],
      "properties": {
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_transitions": {
          "type": "integer",
          "minimum": 1
        },
        "used_transitions": {
          "type": "integer",
          "minimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "used_tool_calls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 256
          }
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": true
        }
      }
    }
  }
}
